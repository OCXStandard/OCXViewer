<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.prostep.openpdm</groupId>
    <artifactId>OCXViewer-parent</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ocxviewer-parent</name>

    <modules>
        <module>ocx-schema-version</module>
        <module>ocx-viewer</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21</javafx.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
        <junit.version>5.10.2</junit.version>
        <atlantafx.version>2.0.1</atlantafx.version>

        <hisrc-basicjaxb.version>2.2.1</hisrc-basicjaxb.version>
        <hisrc-higherjaxb-maven-plugin.version>2.2.1</hisrc-higherjaxb-maven-plugin.version>

        <!-- this is used to fill in the build timestamp in mvn.properties -->
        <timestamp>${maven.build.timestamp}</timestamp>
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm</maven.build.timestamp.format>

        <!-- Windows delivery via jpackage: a self-contained app-image (zipped as the
             portable delivery) + an MSI installer. jpackage invokes jlink to build a
             minimal runtime from the module set below - NO JRE is checked into the repo. -->
        <skip-jpackage>false</skip-jpackage>      <!-- skip the whole native-packaging block (app-image + zip + msi) -->
        <!-- MSI is OFF by default because it needs WiX Toolset (not on most dev boxes).
             The Jenkins pipeline turns it ON with -Dskip-msi=false on the WiX-equipped agent. -->
        <skip-msi>true</skip-msi>
        <product.name>OCXViewer</product.name>
        <!-- jpackage/MSI require a strictly numeric version (no -SNAPSHOT); bump manually on release -->
        <jpackage.version>0.3.0</jpackage.version>
        <jpackage.vendor>OCXViewer</jpackage.vendor>
        <!-- Stable across releases so MSI upgrades replace the previous install (do NOT change) -->
        <jpackage.upgradeUuid>e9f9b683-d5c8-42f1-9028-c995bb56b910</jpackage.upgradeUuid>
        <!-- Minimal JDK module set, validated by launching the app and running a Schematron
             validation on the trimmed runtime. JavaFX and all 3rd-party libraries travel
             inside the fat jar (classpath), so only these platform modules are required. -->
        <jpackage.modules>java.desktop,java.logging,java.management,java.naming,java.sql,java.scripting,jdk.xml.dom,jdk.zipfs,jdk.charsets,jdk.unsupported</jpackage.modules>
        <zipName>${product.name}-${jpackage.version}.zip</zipName>
        <main-app>de.cadoculus.ocxviewer.Main</main-app>

    </properties>

</project>
